#!/usr/bin/env bash
set -euo pipefail
self=$(readlink -f "${BASH_SOURCE[0]}")
bundle=$(cd "$(dirname "$self")/.." && pwd)
if [[ -f "$bundle/homebrew-prefix" ]]; then
  IFS= read -r brew_prefix < "$bundle/homebrew-prefix"
  export PATH="$brew_prefix/bin:$PATH"
fi
export GSEEK_LAUNCHER="$self"
export GSEEK_RUNTIME_DIR="$bundle/runtime"
export GSEEK_RUNTIME_MANIFEST="$bundle/runtime-manifest.json"
exec "$bundle/bin/gseek-native" "$@"
